# Copy this file to .env and replace the placeholder values.

# --- MinIO / S3 access ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=eu-west-1

# --- Spark runtime ---
SPARK_VERSION=3.5.1
HADOOP_VERSION=3
ICEBERG_VERSION=1.5.2
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

# --- Polaris catalog config ---
POLARIS_REALM=LOCAL-POLARIS
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=change-me
POLARIS_PERSISTENCE_AUTO_BOOTSTRAP_TYPES=relational-jdbc
POLARIS_DB_NAME=polaris
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=change-me

# --- One-time bootstrap values ---
MINIO_BOOTSTRAP_BUCKET=minio-local-bucket
POLARIS_BOOTSTRAP_CATALOG_NAME=polaris_local_catalog
POLARIS_BOOTSTRAP_WAREHOUSE_PREFIX=local-data
